# =========================
# SmartAsk 环境变量配置示例模板 (.env.example)
# 使用方法：复制本文件为 .env 并填入实际敏感信息
# =========================

# Backend
SMARTASK_BACKEND_PORT=5002
SMARTASK_SECRET_KEY=your_secret_key_here
SMARTASK_DEBUG=true
SMARTASK_CHROMA_PATH=./chroma_db

# 默认 AI 模型 (由 config/ai_settings.json 管理，不在此覆盖)
# SMARTASK_AI_LABEL=通义千问 qwen-max
# SMARTASK_AI_PROVIDER=dashscope
# SMARTASK_AI_MODEL=qwen-max
# SMARTASK_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SMARTASK_AI_API_KEY=your_dashscope_api_key

# 默认数据源
SMARTASK_DB_LABEL=Feishu DTable Sync
SMARTASK_DB_TYPE=postgresql
SMARTASK_DB_HOST=localhost
SMARTASK_DB_PORT=5432
SMARTASK_DB_DATABASE=postgres
SMARTASK_DB_USERNAME=postgres
SMARTASK_DB_PASSWORD=your_postgres_password
SMARTASK_POSTGRES_PASSWORD=your_postgres_password
SMARTASK_DB_DRIVER=psycopg2

# 飞书同步配置
SMARTASK_FEISHU_LABEL=商用事业部销售结果表
SMARTASK_FEISHU_DESCRIPTION=同步飞书多维表格数据到 PostgreSQL
SMARTASK_FEISHU_APP_ID=your_feishu_app_id
SMARTASK_FEISHU_APP_SECRET=your_feishu_app_secret
SMARTASK_FEISHU_BASE_ID=your_feishu_base_id
SMARTASK_FEISHU_TABLE_ID=your_feishu_table_id
SMARTASK_FEISHU_VIEW_ID=your_feishu_view_id
SMARTASK_FEISHU_TARGET_TABLE=angel_group_data
SMARTASK_FEISHU_SYNC_MODE=full
SMARTASK_FEISHU_SYNC_FREQUENCY=1440
SMARTASK_FEISHU_IS_ACTIVE=true
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_BASE_URL=https://open.feishu.cn
BACKEND_URL=http://localhost:5002
FRONTEND_URL=http://localhost:3000
SMARTASK_AUTH_TOKEN_TTL_DAYS=7

# 本地管理员初始配置
SMARTASK_ADMIN_USERNAME=admin
SMARTASK_ADMIN_PASSWORD=your_admin_password
SMARTASK_ADMIN_DISPLAY_NAME=超级管理员

# Pip 镜像源
SMARTASK_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
SMARTASK_PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
